{
  "name": "pen",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "dev": "turbo run dev --concurrency=32",
    "sync:package-metadata": "node scripts/sync-package-metadata.mjs",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "lint:format": "node scripts/lint-format.mjs",
    "lint:eslint": "eslint . --max-warnings 1215",
    "lint": "pnpm lint:format && pnpm lint:eslint",
    "verify": "node scripts/verify.mjs",
    "changeset-check": "node scripts/changeset-check.mjs",
    "workflow-integrity": "node scripts/workflow-integrity.mjs",
    "version-packages": "changeset version && node scripts/stamp-first-train.mjs",
    "release": "changeset publish",
    "release-check": "node scripts/release-check.mjs",
    "size-limit": "node scripts/size-limit.mjs",
    "ch-gates": "node scripts/ch-gates.mjs",
    "verdaccio-closure-check": "node scripts/verdaccio-closure-check.mjs",
    "dag-check": "node scripts/dag-check.mjs",
    "types-purity": "node scripts/types-purity.mjs",
    "api-reports": "node scripts/api-reports.mjs",
    "doc-refs": "node scripts/doc-refs.mjs",
    "catalog:check": "node scripts/catalog-check.mjs",
    "command-catalog-check": "node scripts/command-catalog-check.mjs",
    "workspace-pins": "node scripts/workspace-pins.mjs",
    "readme-sections": "node scripts/readme-sections.mjs",
    "api-docs-coverage": "node scripts/api-docs-coverage.mjs",
    "capability-matrix": "node --test scripts/__tests__/capabilityMatrix.test.mjs && node scripts/check-capability-matrix.mjs --self-test && node scripts/check-capability-matrix.mjs",
    "coverage:rules": "node --test scripts/__tests__/ruleCoverage.test.mjs && node scripts/rule-coverage.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.ts",
          "*.tsx",
          "*.mts",
          "*.cts",
          "*.mjs",
          "*.cjs",
          "*.js",
          "*.jsx"
        ],
        "options": {
          "useTabs": true,
          "tabWidth": 4,
          "endOfLine": "lf"
        }
      }
    ]
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@input/pen-eslint-plugin": "workspace:*",
    "@playwright/test": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
