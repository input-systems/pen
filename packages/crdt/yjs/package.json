{
  "name": "@input/pen-yjs",
  "version": "0.3.0",
  "description": "Yjs CRDT adapter for Pen",
  "license": "MIT",
  "homepage": "https://github.com/input-systems/pen#readme",
  "bugs": {
    "url": "https://github.com/input-systems/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/input-systems/pen.git",
    "directory": "packages/crdt/yjs"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./awareness": {
      "import": {
        "types": "./dist/awareness.d.ts",
        "default": "./dist/awareness.mjs"
      },
      "require": {
        "types": "./dist/awareness.d.cts",
        "default": "./dist/awareness.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-types": "workspace:^"
  },
  "peerDependencies": {
    "y-protocols": "^1.0.7",
    "yjs": "^13.6"
  },
  "peerDependenciesMeta": {
    "y-protocols": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tsup": "^8.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "yjs-duplicate": "npm:yjs@13.6.33"
  }
}
