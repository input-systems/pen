{
  "name": "@input/pen-undo",
  "version": "0.0.1",
  "description": "Undo/redo extension with origin tagging for Pen",
  "license": "MIT",
  "homepage": "https://github.com/input-systems/pen#readme",
  "bugs": {
    "url": "https://github.com/input-systems/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/input-systems/pen.git",
    "directory": "packages/extensions/undo"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-core": "workspace:^",
    "@input/pen-types": "workspace:^"
  },
  "devDependencies": {
    "@input/pen-crdt-yjs": "workspace:*",
    "@input/pen-schema-default": "workspace:*",
    "@input/pen-test": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yjs": "^13.6.29"
  }
}
