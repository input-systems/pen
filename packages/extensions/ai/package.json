{
  "name": "@input/pen-ai",
  "version": "0.1.8",
  "description": "AI extension, suggestions, autocomplete, skills, tools, and streaming for Pen",
  "license": "MIT",
  "homepage": "https://github.com/input-systems/pen#readme",
  "bugs": {
    "url": "https://github.com/input-systems/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/input-systems/pen.git",
    "directory": "packages/extensions/ai"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./suggestions": {
      "import": {
        "types": "./dist/suggestions.d.ts",
        "default": "./dist/suggestions.mjs"
      },
      "require": {
        "types": "./dist/suggestions.d.cts",
        "default": "./dist/suggestions.cjs"
      }
    },
    "./autocomplete": {
      "import": {
        "types": "./dist/autocomplete.d.ts",
        "default": "./dist/autocomplete.mjs"
      },
      "require": {
        "types": "./dist/autocomplete.d.cts",
        "default": "./dist/autocomplete.cjs"
      }
    },
    "./skills": {
      "import": {
        "types": "./dist/skills.d.ts",
        "default": "./dist/skills.mjs"
      },
      "require": {
        "types": "./dist/skills.d.cts",
        "default": "./dist/skills.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools.d.ts",
        "default": "./dist/tools.mjs"
      },
      "require": {
        "types": "./dist/tools.d.cts",
        "default": "./dist/tools.cjs"
      }
    },
    "./stream": {
      "import": {
        "types": "./dist/stream.d.ts",
        "default": "./dist/stream.mjs"
      },
      "require": {
        "types": "./dist/stream.d.cts",
        "default": "./dist/stream.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-ingest": "workspace:^",
    "@input/pen-core": "workspace:^",
    "@input/pen-tools": "workspace:^",
    "@input/pen-types": "workspace:^"
  },
  "devDependencies": {
    "@input/pen-schema": "workspace:^",
    "@input/pen-test": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
