{
  "name": "@input/pen-docs",
  "private": true,
  "version": "0.0.1",
  "description": "Repository documentation site for Pen",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./scripts/check-doc2-pages.mjs && node ./scripts/check-collaboration-contract.mjs && node ./scripts/generate-doc-tables.mjs && node ./scripts/check-doc2-samples.mjs && vite build",
    "preview": "vite preview",
    "check:pages": "node ./scripts/check-doc2-pages.mjs",
    "check:collaboration": "node ./scripts/check-collaboration-contract.mjs",
    "check:tables": "node ./scripts/generate-doc-tables.mjs",
    "check:samples": "node ./scripts/check-doc2-samples.mjs",
    "generate:tables": "node ./scripts/generate-doc-tables.mjs --write",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@input/pen": "workspace:*",
    "@input/pen-ai": "workspace:*",
    "@input/pen-assets": "workspace:*",
    "@input/pen-autoformat": "workspace:*",
    "@input/pen-bench": "workspace:*",
    "@input/pen-core": "workspace:*",
    "@input/pen-dom": "workspace:*",
    "@input/pen-ingest": "workspace:*",
    "@input/pen-interop": "workspace:*",
    "@input/pen-markdown": "workspace:*",
    "@input/pen-multiplayer": "workspace:*",
    "@input/pen-react": "workspace:*",
    "@input/pen-schema": "workspace:*",
    "@input/pen-search": "workspace:*",
    "@input/pen-shortcuts": "workspace:*",
    "@input/pen-snapshots": "workspace:*",
    "@input/pen-test": "workspace:*",
    "@input/pen-tools": "workspace:*",
    "@input/pen-transport": "workspace:*",
    "@input/pen-types": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "@input/pen-vue": "workspace:*",
    "@input/pen-yjs": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
