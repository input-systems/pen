{
  "name": "@input/pen-react",
  "version": "0.1.2",
  "description": "React primitives, hooks, and renderers for Pen",
  "license": "MIT",
  "homepage": "https://github.com/input-systems/pen#readme",
  "bugs": {
    "url": "https://github.com/input-systems/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/input-systems/pen.git",
    "directory": "packages/rendering/react"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai": {
      "import": {
        "types": "./dist/ai.d.ts",
        "default": "./dist/ai.mjs"
      },
      "require": {
        "types": "./dist/ai.d.cts",
        "default": "./dist/ai.cjs"
      }
    },
    "./ai-suggestions": {
      "import": {
        "types": "./dist/aiSuggestions.d.ts",
        "default": "./dist/aiSuggestions.mjs"
      },
      "require": {
        "types": "./dist/aiSuggestions.d.cts",
        "default": "./dist/aiSuggestions.cjs"
      }
    },
    "./snapshots": {
      "import": {
        "types": "./dist/snapshots.d.ts",
        "default": "./dist/snapshots.mjs"
      },
      "require": {
        "types": "./dist/snapshots.d.cts",
        "default": "./dist/snapshots.cjs"
      }
    },
    "./multiplayer": {
      "import": {
        "types": "./dist/multiplayer.d.ts",
        "default": "./dist/multiplayer.mjs"
      },
      "require": {
        "types": "./dist/multiplayer.d.cts",
        "default": "./dist/multiplayer.cjs"
      }
    },
    "./search": {
      "import": {
        "types": "./dist/search.d.ts",
        "default": "./dist/search.mjs"
      },
      "require": {
        "types": "./dist/search.d.cts",
        "default": "./dist/search.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "STYLING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@input/pen-core": "workspace:^",
    "@input/pen-dom": "workspace:^",
    "@input/pen-schema": "workspace:^",
    "@input/pen-shortcuts": "workspace:^",
    "@input/pen-types": "workspace:^"
  },
  "peerDependencies": {
    "@input/pen-ai": "workspace:^",
    "@input/pen-snapshots": "workspace:^",
    "@input/pen-interop": "workspace:^",
    "@input/pen-multiplayer": "workspace:^",
    "@input/pen-search": "workspace:^",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@input/pen-ai": {
      "optional": true
    },
    "@input/pen-snapshots": {
      "optional": true
    },
    "@input/pen-interop": {
      "optional": true
    },
    "@input/pen-multiplayer": {
      "optional": true
    },
    "@input/pen-search": {
      "optional": true
    }
  },
  "devDependencies": {
    "@input/pen-ai": "workspace:*",
    "@input/pen-tools": "workspace:*",
    "@input/pen-snapshots": "workspace:*",
    "@input/pen-interop": "workspace:*",
    "@input/pen-multiplayer": "workspace:*",
    "@input/pen": "workspace:*",
    "@input/pen-search": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^28.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
