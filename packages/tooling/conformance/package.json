{
  "name": "@input/pen-conformance",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-real conformance harness and scenario suites for Pen",
  "type": "module",
  "scripts": {
    "harness:dev": "vite --config harness/vite.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "test:chromium": "playwright test --project=chromium",
    "test:webkit": "playwright test --project=webkit",
    "test:firefox": "playwright test --project=firefox",
    "test:matrix": "playwright test",
    "test:axe": "playwright test scenarios/ax1-surface-semantics.spec.ts scenarios/ax8-wcag.spec.ts --project=chromium",
    "test:host-e7": "playwright test scenarios/host4-insecure.spec.ts scenarios/host6-unstyled.spec.ts --project=chromium",
    "test:ax3": "playwright test scenarios/ax3-keyboard.spec.ts --project=chromium",
    "test:ax6": "playwright test scenarios/ax6-reduced-motion.spec.ts --project=chromium",
    "test:scale5": "playwright test scenarios/scale5-virtualization.spec.ts --project=chromium",
    "test:typing-budget": "playwright test scenarios/sch-typing-budget.record.spec.ts --project=chromium",
    "record:typing-budget": "RECORD_TYPING_BUDGET=1 playwright test scenarios/sch-typing-budget.record.spec.ts --project=chromium",
    "report:typing-budget": "node src/reportTypingBudget.js",
    "test:host4": "playwright test scenarios/host4-degradation.spec.ts --project=chromium",
    "test:pseudo-locale": "playwright test scenarios/loc1-pseudo-locale.spec.ts --project=chromium",
    "test:hosts": "node --experimental-strip-types --test src/hosts/*.test.js",
    "test:node": "node --experimental-strip-types --test src/hosts/*.test.js",
    "test": "node --experimental-strip-types --test src/hosts/*.test.js",
    "test:op-equality": "node --experimental-strip-types --test src/op-equality.test.js",
    "record:op-equality": "node --experimental-strip-types src/opCorpus/record.js",
    "fuzz:node": "node src/fuzz/node.mjs",
    "fuzz:nightly": "node src/fuzz/nightly.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:mirrors": "node ../../../scripts/conformance-mirror-drift.mjs"
  },
  "dependencies": {
    "@input/pen-ai": "workspace:*",
    "@input/pen-core": "workspace:*",
    "@input/pen-yjs": "workspace:*",
    "@input/pen-tools": "workspace:*",
    "@input/pen-dom": "workspace:*",
    "@input/pen-interop": "workspace:*",
    "@input/pen": "workspace:*",
    "@input/pen-react": "workspace:*",
    "@input/pen-schema": "workspace:*",
    "@input/pen-test": "workspace:*",
    "@input/pen-types": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@input/pen-assets": "workspace:*",
    "@input/pen-bench": "workspace:*",
    "@input/pen-ingest": "workspace:*",
    "@input/pen-snapshots": "workspace:*",
    "@input/pen-autoformat": "workspace:*",
    "@input/pen-markdown": "workspace:*",
    "@input/pen-multiplayer": "workspace:*",
    "@input/pen-search": "workspace:*",
    "@input/pen-shortcuts": "workspace:*",
    "@input/pen-transport": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "@input/pen-vue": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.3"
  }
}
