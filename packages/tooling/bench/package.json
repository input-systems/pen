{
  "name": "@input/pen-bench",
  "version": "0.3.0",
  "description": "Performance benchmarks for Pen",
  "license": "MIT",
  "homepage": "https://github.com/input-systems/pen#readme",
  "bugs": {
    "url": "https://github.com/input-systems/pen/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/input-systems/pen.git",
    "directory": "packages/tooling/bench"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "bench": "tsx src/cli.ts",
    "bench:ci": "vitest run && tsx src/cli.ts",
    "bench:envelope": "tsx src/cli.ts --envelope",
    "bench:envelope:write": "tsx src/cli.ts --write-envelope",
    "bench:envelope:table": "tsx src/envelope/writeTable.ts",
    "bench:envelope:renderer": "tsx src/envelope/importRenderer.ts",
    "bench:scale3:peers": "tsx src/scale3PeersReport.ts",
    "bench:envelope:drift": "tsx src/envelope/checkDrift.cli.ts",
    "bench:anchors": "tsx src/anchors/run.cli.ts",
    "bench:anchors:compare": "tsx src/anchors/run.cli.ts --compare",
    "clean": "rm -rf dist *.tsbuildinfo",
    "bench:scale3:realistic": "tsx src/fixtures/scale3Realistic.cli.ts",
    "bench:caches": "tsx src/cacheAudit/run.cli.ts"
  },
  "devDependencies": {
    "@input/pen-ai": "workspace:*",
    "@input/pen-core": "workspace:*",
    "@input/pen-multiplayer": "workspace:*",
    "@input/pen-schema": "workspace:*",
    "@input/pen-search": "workspace:*",
    "@input/pen-test": "workspace:*",
    "@input/pen-tools": "workspace:*",
    "@input/pen-types": "workspace:*",
    "@input/pen-undo": "workspace:*",
    "@input/pen-yjs": "workspace:*",
    "@types/node": "^25.9.9",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "yjs": "^13.6.33"
  }
}
